@model IEnumerable<HoangThiThuHue_241230737.Models.HangHoa>

<div class="content_top">
	<div class="heading">
		<h3>Hoang Thi Thu Hue</h3>
	</div>
	<div class="see">
		<p><a href="#">See all Products</a></p>
	</div>
	<div class="clear"></div>
</div>
<div class="section group">
	@foreach(var hh in Model)
	{
		<div class="grid_1_of_4 images_1_of_4">
			<a href="#"><img src="/images/@hh.Anh" alt="" /></a>
			<h2>@hh.TenHang</h2>
			<div class="price-details">
				<div class="price-number">
					<p><span class="rupees">@hh.Gia</span></p>
				</div>
				<div class="add-cart">
					<h4><a href="#">Add to Cart</a></h4>
				</div>
				<div class="clear"></div>
			</div>
		</div>
	}
</div>

